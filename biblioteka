ADD Kara DECIMAL(10, 2) DEFAULT 0;

-- Wypełnienie kolumny 'Cena' losowymi wartościami z przedziału 20-50

DECLARE @Index INT = 1;
DECLARE @RandomPrice DECIMAL(10, 2);

WHILE @Index <= 80
BEGIN
    SET @RandomPrice = ROUND((RAND() * (50 - 20) + 20), 2);

    UPDATE Książka
    SET Cena = @RandomPrice
    WHERE Książka_ID = @Index;

    SET @Index = @Index + 1;
END;

--kara za przetrzymanie książki

GO
CREATE FUNCTION oblicz_kare (
    @DataWypozyczenia DATE,
    @DataZwrotu DATE,
    @Książka_ID INT
)
RETURNS DECIMAL(10, 2)
AS
BEGIN
    DECLARE @DniPrzetrzymania INT;
    DECLARE @Kara DECIMAL(10, 2);
    DECLARE @Cena DECIMAL(10, 2);

    -- Pobierz cenę książki na podstawie Książka_ID
    SELECT @Cena = Cena
    FROM Książka
    WHERE Książka_ID = @Książka_ID;

    -- Jeśli DataZwrotu jest NULL, używamy bieżącej daty
    IF @DataZwrotu IS NULL
    BEGIN
        SET @DniPrzetrzymania = DATEDIFF(DAY, @DataWypozyczenia, GETDATE()) - 30;
    END
    ELSE
    BEGIN
        SET @DniPrzetrzymania = DATEDIFF(DAY, @DataWypozyczenia, @DataZwrotu) - 30;
    END

    -- Oblicz karę tylko, jeśli dni przetrzymania > 0
    IF @DniPrzetrzymania > 0
    BEGIN
        SET @Kara = @DniPrzetrzymania * (@Cena * 0.01);
    END
    ELSE
    BEGIN
        SET @Kara = 0;
    END

    RETURN @Kara;
END;
GO


    -- Oznacz egzemplarz jako dostępny po zwrocie (jeśli Data_zwrotu nie jest NULL)
    UPDATE Egzemplarz
    SET Dostępność = 'Dostępny'
    WHERE Egzemplarz_ID IN (
        SELECT Egzemplarz_ID
    FROM INSERTED
    WHERE Data_zwrotu IS NOT NULL
    );

END;

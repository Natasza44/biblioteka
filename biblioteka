--FUNKCJA Naliczanie kary za przetrzymanie książki

-- Dodanie kolumny 'Cena' do tabeli 'Książka' oraz 'Kara' do tabeli 'Wypożyczenie'
ALTER TABLE Książka
ADD Cena DECIMAL(10, 2);


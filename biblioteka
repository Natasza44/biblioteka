CREATE PROCEDURE dodaj_czytelnika
    @Imie VARCHAR(50),
    @Nazwisko VARCHAR(50),
    @Email VARCHAR(100),
    @Telefon VARCHAR(15)
AS
BEGIN
    -- Sprawdzenie, czy email już istnieje
    IF EXISTS (SELECT 1
    FROM czytelnik
    WHERE Email = @Email)
    BEGIN
        PRINT 'Czytelnik z podanym adresem email już istnieje.';
    END
    ELSE
    BEGIN
        -- Dodanie nowego czytelnika
        INSERT INTO czytelnik
            (Imię, Nazwisko, Email, Telefon, Data_rejestracji)
        VALUES
            (@Imie, @Nazwisko, @Email, @Telefon, GETDATE());

        PRINT 'Nowy czytelnik został pomyślnie dodany.';
    END
END;


--Procedura (3) Sprawdzanie, czy książka jest wypożyczona

DECLARE @Tytuł NVARCHAR(255);
DECLARE @Autor NVARCHAR(255);
GO
CREATE PROCEDURE Sprawdź_Dostępność_Książki
    @Tytuł NVARCHAR(255),
    @Autor NVARCHAR(255)
AS
BEGIN
    IF EXISTS (
        SELECT 1
    FROM [dbo].[Książka] K
        JOIN [dbo].[Egzemplarz] E
        ON K.[Książka_ID] = E.[Książka_ID]
        LEFT JOIN [dbo].[Wypożyczenie] W
        ON W.[Egzemplarz_ID] = E.[Egzemplarz_ID]
            AND W.[Data_zwrotu] IS NULL
    WHERE K.[Tytuł] = @Tytuł AND K.[Autor] = @Autor AND W.[Wypożyczenie_ID] IS NULL
    )
BEGIN
        SELECT DISTINCT
            B.[Biblioteka_ID], B.[Nazwa_biblioteki], K.[Tytuł], K.[Autor]
        FROM [dbo].[Książka] K
            JOIN [dbo].[Egzemplarz] E
            ON K.[Książka_ID] = E.[Książka_ID]
            LEFT JOIN [dbo].[Wypożyczenie] W
            ON W.[Egzemplarz_ID] = E.[Egzemplarz_ID]
                AND W.[Data_zwrotu] IS NULL
            JOIN [dbo].[Biblioteka] B
            ON B.[Biblioteka_ID] = E.[Biblioteka_ID]
        WHERE K.[Tytuł] = @Tytuł AND K.[Autor] = @Autor AND W.[Wypożyczenie_ID] IS NULL
    END
    ELSE
    BEGIN
        PRINT 'Niestety, wszystkie egzemplarze tej książki są w tej chwili niedostępne.'
    END
END;
GO

AS
    WITH
        IlośćTransakcji
        AS
        (
            SELECT
                w.[Pracownik_ID],
                COUNT(*) AS ilość_transakcji
            FROM [dbo].[Wypożyczenie] w
            GROUP BY w.[Pracownik_ID]
        )
    SELECT
        p.[Imię] + ' ' + p.[Nazwisko] AS 'Imię i nazwisko',
        t.ilość_transakcji
    FROM IlośćTransakcji t
        JOIN [dbo].[Pracownicy] p
        ON p.[Pracownik_ID] = t.[Pracownik_ID]
    WHERE t.ilość_transakcji = (
        SELECT MAX(ilość_transakcji)
